# Optional: override where app-generated WebM recordings are stored.
# If omitted, recordings are saved under Electron's userData directory.
# VIDEO_TOOL_RECORDINGS_DIR=/absolute/path/to/recordings

# Optional: VieNeu-TTS v3 Turbo local server. The default is shown below.
# Only loopback HTTP URLs are accepted; OpenScene never installs or downloads the model.
# OPENSCENE_VIENEU_BASE_URL=http://127.0.0.1:8001
